CREATE TABLE Usuarios (
    id_usuario INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL,
    mail TEXT NOT NULL,
    passwd TEXT NOT NULL,
    esAdmin INTEGER NOT NULL CHECK (esAdmin IN (0, 1)) -- 1 si es admin, 0 si es un usuario normal
);


CREATE TABLE Eventos (
    id_evento INTEGER PRIMARY KEY AUTOINCREMENT,
    titulo TEXT NOT NULL,
    fecha TEXT NOT NULL CHECK (
        fecha GLOB '[1-9]/[1-9]/[0-9][0-9][0-9][0-9]' OR
        fecha GLOB '[1-9]/[0-1][0-9]/[0-9][0-9][0-9][0-9]' OR
        fecha GLOB '[0-3][0-9]/[1-9]/[0-9][0-9][0-9][0-9]' OR
        fecha GLOB '[0-3][0-9]/[0-1][0-9]/[0-9][0-9][0-9][0-9]'
    ),
    direccion TEXT NOT NULL,
    latitud REAL NOT NULL,
    longitud REAL NOT NULL
);

GetUsuarioPorEmail:
SELECT * FROM Usuarios WHERE mail = ?;

-- Consultas Usuarios
GetUsuarios:
SELECT * FROM Usuarios;

GetEventos:
SELECT * FROM Eventos;

GetUsuarioExistente:
SELECT * FROM Usuarios WHERE username = ? AND mail = ?;

GetUsuarioPorUsername:
SELECT * FROM Usuarios WHERE username = ?;

GetUsuarioPorUsernameAndPassword:
SELECT * FROM Usuarios WHERE username = ? AND passwd = ?;

GetUsuarioPorId:
SELECT * FROM Usuarios WHERE id_usuario = ?;

RegistrarUsuario:
INSERT INTO Usuarios (username,mail,passwd,esAdmin) VALUES (?,?,?,?);

--ConfigUseroptions
UpdateMail:
UPDATE Usuarios SET mail = ? WHERE id_usuario = ?;

UpdateUser:
UPDATE Usuarios SET username = ? WHERE id_usuario = ?;
UpdatePassword:
UPDATE Usuarios SET passwd = ? WHERE id_usuario = ?;
EliminarUsuario:
DELETE FROM Usuarios WHERE id_usuario = ?;


-- Consultas eventos

GetEventosOrdenadosPorFecha:
SELECT *
FROM Eventos
ORDER BY substr(fecha, 7, 4) || '-' || substr(fecha, 4, 2) || '-' || substr(fecha, 1, 2) ASC;

GetEventoPorId:
SELECT * FROM Eventos WHERE id_evento = ?;

RegistrarEvento:
INSERT INTO Eventos (titulo,fecha,direccion,latitud,longitud) VALUES (?,?,?,?,?);

